#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac
modprobe qemu_fw_cfg 2>/dev/null || true
identity=/sys/firmware/qemu_fw_cfg/by_name/opt/org.platypus/machine-id/raw
if [ -r "$identity" ]; then
  value=$(tr -d '\000\n' < "$identity")
  case "$value" in *[!0-9a-f]*|'') exit 1;; esac
  [ "${#value}" -eq 32 ] || exit 1
  while read -r device target rest; do
    if [ "$target" = "$rootmnt" ]; then
      mount -o remount,rw "$device" "$rootmnt" || exit 1
      break
    fi
  done < /proc/mounts
  printf '%s\n' "$value" > "$rootmnt/etc/machine-id"
fi
